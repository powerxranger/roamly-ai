# Copy to .env and fill in. .env is gitignored and never enters the Docker image.

# ---- LLM ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- MCP servers ----
# Remote (HTTP)
TAVILY_API_KEY=
# Local (stdio)
OPENWEATHER_API_KEY=

# ---- Server ----
HOST=127.0.0.1
PORT=8000
RELOAD=true

# Host-side ports for docker compose.
APP_PORT=8000

