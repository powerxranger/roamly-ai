# Copy to .env and fill in. .env is gitignored and never enters the Docker image.

# ---- LLM Providers (Primary: Gemini, Fallback: Groq) ----
# Primary: Google Gemini Flash (1,500 free requests/day from aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Fallback: Groq (200,000 free tokens/day from console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# ---- MCP servers ----
# Remote (HTTP)
TAVILY_API_KEY=
# Local (stdio)
OPENWEATHER_API_KEY=

# ---- Server ----
HOST=127.0.0.1
PORT=8000
RELOAD=true

# Host-side ports for docker compose.
APP_PORT=8000

